{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelverse.local/schemas/html-scene-brief.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "cardType",
    "sceneId",
    "title",
    "layoutEngine",
    "stateVariables",
    "nodes"
  ],
  "properties": {
    "schemaVersion": { "const": "novel-html-brief.v1" },
    "cardType": { "const": "html_scene_brief" },
    "sceneId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "layoutEngine": {
      "type": "object",
      "required": ["type", "theme"],
      "properties": {
        "type": { "enum": ["visual-novel", "text-adventure"] },
        "theme": { "enum": ["dark-glass", "light-minimal"] }
      },
      "additionalProperties": false
    },
    "stateVariables": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sceneNode" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sceneNode": {
      "type": "object",
      "required": ["id", "text", "choices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "speaker": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "visuals": {
          "type": "object",
          "properties": {
            "background": { "type": "string" },
            "characterSprite": { "type": "string" },
            "effect": { "type": "string" }
          },
          "additionalProperties": false
        },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": ["label", "target"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["state", "operator", "value"],
            "properties": {
              "state": { "type": "string" },
              "operator": { "enum": ["==", "!=", ">", "<", ">=", "<="] },
              "value": { "type": ["string", "number", "boolean"] }
            },
            "additionalProperties": false
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["state", "operation", "value"],
            "properties": {
              "state": { "type": "string" },
              "operation": { "enum": ["set", "add", "subtract"] },
              "value": { "type": ["string", "number", "boolean"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
